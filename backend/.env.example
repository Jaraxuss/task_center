# 后端监听地址（可选）
TASK_CENTER_API_HOST=0.0.0.0
TASK_CENTER_API_PORT=8000

# 允许访问后端的前端地址，多个值用英文逗号分隔
# 例如前端跑在 192.168.31.169:5173 时：
# TASK_CENTER_CORS_ORIGINS=http://192.168.31.169:5173,http://127.0.0.1:5173,http://localhost:5173
TASK_CENTER_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 飞书卡片 V2 SDK（可选；用于 TaskCenter 直接通过飞书开放平台发送卡片/文本提醒）
# 推荐使用 TASK_CENTER_* 命名；FEISHU_APP_ID / FEISHU_APP_SECRET 仍作为兼容 fallback。
TASK_CENTER_FEISHU_APP_ID=cli_xxx
TASK_CENTER_FEISHU_APP_SECRET=xxx
TASK_CENTER_FEISHU_DEFAULT_RECEIVE_ID=ou_xxx
TASK_CENTER_FEISHU_DEFAULT_RECEIVE_ID_TYPE=open_id
